    {
      "id": "b000008",
      "kind": "blank",
      "start_line": 15,
      "end_line": 15,
      "raw": "\n"
    },
    {
      "id": "b000009",
      "kind": "paragraph",
      "start_line": 16,
      "end_line": 16,
      "raw": "The final settings image is enlarged and placed above the main editor original in the same session to maintain readability of the small auxiliary window. Only the actual  Vincent  UI and capture data were used, and no arbitrary  UI  elements were added. The capture profile and  LAN  sharing status were restored to the original state immediately after capture.\n"
    }
