#include <windows.h>

IDI_ICON1 ICON "@VINCENT_WINDOWS_APP_ICON_RC@"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@VINCENT_WINDOWS_MANIFEST_RC@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VINCENT_WINDOWS_VERSION_COMMA@
 PRODUCTVERSION @VINCENT_WINDOWS_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Vincent raster drawing application\0"
            VALUE "FileVersion", "@VINCENT_WINDOWS_VERSION_DOTTED@\0"
            VALUE "InternalName", "Vincent\0"
            VALUE "OriginalFilename", "Vincent.exe\0"
            VALUE "ProductName", "Vincent\0"
            VALUE "ProductVersion", "@VINCENT_WINDOWS_VERSION_DOTTED@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
